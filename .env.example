# URL de l'API Express, appelée côté serveur par Next.js
# Local          : http://127.0.0.1:4000
# Docker Compose : http://api:4000
API_URL=http://127.0.0.1:4000

# PostgreSQL (valeurs factices : copier vers .env et changer le mot de passe)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change_me
POSTGRES_DB=portfolio
# Hors Docker : localhost ; dans Docker Compose : le service "db"
DATABASE_URL=postgresql://portfolio:change_me@localhost:5432/portfolio?schema=public
